{
  "redirects": [
    {
      "source": "/favicon.ico",
      "destination": "/icons/favicon.ico",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/js/(.*).js",
      "headers": [
        { "key": "Content-Type", "value": "application/javascript; charset=utf-8" }
      ]
    }
  ]
}
